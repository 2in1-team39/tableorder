# 로컬에서는 비워두면 SQLite를 사용합니다.
# Vercel에서는 Neon 연동이 자동으로 넣어 주는 DATABASE_URL이 필수입니다.
DATABASE_URL=

# 운영 환경에서는 충분히 긴 임의의 문자열을 설정하세요.
DJANGO_SECRET_KEY=

# 최초 배포 때 관리자 계정을 생성합니다. 다음 배포에서도 같은 사용자 비밀번호로 갱신됩니다.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

# 커스텀 도메인이 있다면 쉼표로 구분해 추가하세요. 예: order.example.com
DJANGO_ALLOWED_HOSTS=

# 필요한 경우 HTTPS Origin을 직접 추가합니다. 예: https://order.example.com
# DJANGO_ALLOWED_HOSTS의 도메인은 Vercel 배포 시 자동으로 신뢰됩니다.
DJANGO_CSRF_TRUSTED_ORIGINS=
