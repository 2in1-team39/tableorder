# 로컬에서는 비워두면 SQLite를 사용합니다.
# Vercel에서는 Neon 연동이 자동으로 넣어 주는 DATABASE_URL이 필수입니다.
DATABASE_URL=

# 운영 환경에서는 충분히 긴 임의의 문자열을 설정하세요.
DJANGO_SECRET_KEY=

# 커스텀 도메인이 있다면 쉼표로 구분해 추가하세요. 예: order.example.com
DJANGO_ALLOWED_HOSTS=

# Vercel에서는 기본적으로 QR 이미지 생성을 끕니다. 필요할 때만 별도 파일 저장소와 함께 활성화하세요.
GENERATE_QR_CODES=0
